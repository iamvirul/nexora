    <profiles>
        <!-- Publishes the library modules to Maven Central: `mvn -P release deploy`, run by the Publish
             workflow on each v* tag. Signing reads the armored private key and its passphrase from
             MAVEN_GPG_KEY and MAVEN_GPG_PASSPHRASE; the upload uses the Central Portal user token
             configured as server "central" in settings.xml. -->
        <profile>
            <id>release</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-source-plugin</artifactId>
                        <version>${maven-source-plugin.version}</version>
                        <executions>
                            <execution>
                                <id>attach-sources</id>
                                <goals>
                                    <goal>jar-no-fork</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-javadoc-plugin</artifactId>
                        <version>${maven-javadoc-plugin.version}</version>
                        <configuration>
                            <source>${java.version}</source>
                            <!-- Undocumented members are allowed; broken HTML and references still fail the release. -->
                            <doclint>all,-missing</doclint>
                            <quiet>true</quiet>
                        </configuration>
                        <executions>
                            <execution>
                                <id>attach-javadocs</id>
                                <goals>
                                    <goal>jar</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.apache.maven.plugins</groupId>
                        <artifactId>maven-gpg-plugin</artifactId>
                        <version>${maven-gpg-plugin.version}</version>
                        <configuration>
                            <!-- Bouncy Castle signer: signs from MAVEN_GPG_KEY, no gpg binary or keyring needed. -->
                            <signer>bc</signer>
                        </configuration>
                        <executions>
                            <execution>
                                <id>sign-artifacts</id>
                                <phase>verify</phase>
                                <goals>
                                    <goal>sign</goal>
                                </goals>
                            </execution>
                        </executions>
                    </plugin>
                    <plugin>
                        <groupId>org.sonatype.central</groupId>
                        <artifactId>central-publishing-maven-plugin</artifactId>
                        <version>${central-publishing-plugin.version}</version>
                        <extensions>true</extensions>
                        <configuration>
                            <publishingServerId>central</publishingServerId>
                            <autoPublish>true</autoPublish>
                            <waitUntil>published</waitUntil>
                            <deploymentName>nexora ${project.version}</deploymentName>
                            <!-- Applications and demos, not libraries: the CLI ships as a GitHub Release
                                 jar and a container image, the LLM planner as a plugin jar.
                                 nexora-capabilities has no code yet. -->
                            <excludeArtifacts>
                                <artifact>nexora-cli</artifact>
                                <artifact>nexora-planner-llm</artifact>
                                <artifact>nexora-capabilities</artifact>
                                <artifact>json-config-demo</artifact>
                                <artifact>llm-planner-demo</artifact>
                                <artifact>login-demo</artifact>
                                <artifact>multi-tenant-demo</artifact>
                                <artifact>payment-pipeline</artifact>
                                <artifact>spring-boot-demo</artifact>
                            </excludeArtifacts>
                        </configuration>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>

