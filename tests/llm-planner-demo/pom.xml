<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.virul.nexora</groupId>
        <artifactId>nexora</artifactId>
        <version>0.6.0-SNAPSHOT</version>
        <relativePath>../../pom.xml</relativePath>
    </parent>
    <groupId>com.nexora.samples</groupId>
    <artifactId>llm-planner-demo</artifactId>
    <version>0.6.0-SNAPSHOT</version>
    <description>Runs one goal through the rule-based planner and the LLM planner plugin, side by side.</description>

    <properties>
        <!-- Not published to Maven Central (excluded in the root release profile): skip the release extras. -->
        <maven.source.skip>true</maven.source.skip>
        <maven.javadoc.skip>true</maven.javadoc.skip>
        <gpg.skip>true</gpg.skip>
        <maven.compiler.source>21</maven.compiler.source>
        <maven.compiler.target>21</maven.compiler.target>
        <project.build.sourceEncoding>UTF-8</project.build.sourceEncoding>
    </properties>

    <dependencies>
        <dependency>
            <groupId>me.virul.nexora</groupId>
            <artifactId>nexora-api</artifactId>
        </dependency>
        <dependency>
            <groupId>me.virul.nexora</groupId>
            <artifactId>nexora-planner</artifactId>
        </dependency>
        <dependency>
            <groupId>me.virul.nexora</groupId>
            <artifactId>nexora-plugin-spi</artifactId>
        </dependency>
        <dependency>
            <groupId>org.slf4j</groupId>
            <artifactId>slf4j-api</artifactId>
        </dependency>
        <dependency>
            <groupId>ch.qos.logback</groupId>
            <artifactId>logback-classic</artifactId>
        </dependency>
        <!--
          Not on the classpath: the demo loads the plugin JAR at runtime, as a deployment would. Declared
          (provided, so it is not shaded in) to build it first; maven-dependency-plugin copies it to
          target/plugins.
        -->
        <dependency>
            <groupId>me.virul.nexora</groupId>
            <artifactId>nexora-planner-llm</artifactId>
            <version>${nexora-planner-llm.version}</version>
            <classifier>plugin</classifier>
            <scope>provided</scope>
            <exclusions>
                <exclusion>
                    <groupId>*</groupId>
                    <artifactId>*</artifactId>
                </exclusion>
            </exclusions>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-dependency-plugin</artifactId>
                <version>3.11.0</version>
                <executions>
                    <execution>
                        <id>copy-llm-planner-plugin</id>
                        <phase>package</phase>
                        <goals><goal>copy</goal></goals>
                        <configuration>
                            <artifactItems>
                                <artifactItem>
                                    <groupId>me.virul.nexora</groupId>
                                    <artifactId>nexora-planner-llm</artifactId>
                                    <version>${nexora-planner-llm.version}</version>
                                    <classifier>plugin</classifier>
                                    <destFileName>nexora-planner-llm-plugin.jar</destFileName>
                                </artifactItem>
                            </artifactItems>
                            <outputDirectory>${project.build.directory}/plugins</outputDirectory>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <version>3.6.2</version>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals><goal>shade</goal></goals>
                        <configuration>
                            <finalName>llm-planner-demo</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>com.nexora.samples.llmplanner.LlmPlannerDemoApp</mainClass>
                                </transformer>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ServicesResourceTransformer" />
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <!-- LlmPlannerDemoAppIT runs the demo against the plugin JAR copied above, after package. -->
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-failsafe-plugin</artifactId>
                <configuration>
                    <systemPropertyVariables>
                        <nexora.test.pluginJar>${project.build.directory}/plugins/nexora-planner-llm-plugin.jar</nexora.test.pluginJar>
                    </systemPropertyVariables>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
