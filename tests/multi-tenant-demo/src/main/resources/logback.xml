<configuration>
  <!-- The walkthrough prints its own narrative; only warnings and errors from Nexora itself. -->
  <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
    <encoder>
      <pattern>%d{HH:mm:ss} %-5level %logger{20} - %msg%n</pattern>
    </encoder>
  </appender>

  <root level="ERROR">
    <appender-ref ref="CONSOLE"/>
  </root>
</configuration>
