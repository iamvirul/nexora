<?xml version='1.0' encoding='utf-8'?>
<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>me.virul.nexora</groupId>
        <artifactId>nexora</artifactId>
        <version>0.6.0-SNAPSHOT</version>
    </parent>

    <artifactId>nexora-all</artifactId>
    <packaging>pom</packaging>
    <name>Nexora BOM</name>
    <description>Bill of materials pinning every published Nexora module to one version.</description>

    <!-- Every module published to Maven Central, at this release's version. Keep in step with the
         Publish workflow: a module listed here must be published, and the reverse. -->
    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-core</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-plugin-spi</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-registry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-tracing</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-tracing-otel</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-retry</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-event</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-executor</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-plugin-loader</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-planner</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-saga</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-persistence</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-runtime</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-api</artifactId>
                <version>${project.version}</version>
            </dependency>
            <dependency>
                <groupId>me.virul.nexora</groupId>
                <artifactId>nexora-spring-boot-starter</artifactId>
                <version>${project.version}</version>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <build>
        <plugins>
            <!-- The published BOM must hold only the entries above. Importing a pom imports its whole
                 effective dependencyManagement, so without flattening, the parent's third-party
                 versions (Jackson, H2, Flyway...) would override the importing project's own. -->
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>flatten-maven-plugin</artifactId>
                <version>${flatten-maven-plugin.version}</version>
                <configuration>
                    <flattenMode>bom</flattenMode>
                    <updatePomFile>true</updatePomFile>
                    <pomElements>
                        <properties>remove</properties>
                        <dependencies>remove</dependencies>
                        <build>remove</build>
                        <profiles>remove</profiles>
                    </pomElements>
                </configuration>
                <executions>
                    <execution>
                        <id>flatten</id>
                        <phase>process-resources</phase>
                        <goals>
                            <goal>flatten</goal>
                        </goals>
                    </execution>
                    <execution>
                        <id>flatten-clean</id>
                        <phase>clean</phase>
                        <goals>
                            <goal>clean</goal>
                        </goals>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
